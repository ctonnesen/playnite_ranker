<UserControl
    x:Class="GameRanker.Views.RankedListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop"
    Background="{DynamicResource ControlBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>     <!-- list -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <Border
            Grid.Row="0"
            BorderBrush="{DynamicResource NormalBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,36,10,8"
            Background="{DynamicResource ControlBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Plan to Play — ranking"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextBrush}"
                    VerticalAlignment="Center"/>

                <Button
                    Grid.Column="1"
                    Content="▲"
                    Command="{Binding MoveUpCommand}"
                    Padding="8,6"
                    FontSize="14"
                    Width="36"
                    Foreground="{DynamicResource TextBrush}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    Cursor="Hand"
                    ToolTip="Move selected item up"
                    Margin="10,0,0,0"/>

                <Button
                    Grid.Column="2"
                    Content="▼"
                    Command="{Binding MoveDownCommand}"
                    Padding="8,6"
                    FontSize="14"
                    Width="36"
                    Foreground="{DynamicResource TextBrush}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    Cursor="Hand"
                    ToolTip="Move selected item down"
                    Margin="4,0,0,0"/>

                <Separator
                    Grid.Column="3"
                    Width="1"
                    Margin="10,0"/>

                <Button
                    Grid.Column="4"
                    Content="Wipe all ranks"
                    Command="{Binding WipeAllCommand}"
                    Padding="12,6"
                    FontSize="14"
                    Foreground="{DynamicResource TextBrush}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    Cursor="Hand"
                    ToolTip="Remove all rank tags from every game and clear the saved order"/>
            </Grid>
        </Border>

        <!-- ── Ranked list ── -->
        <Grid Grid.Row="1">
            <ListView
                x:Name="GamesListView"
                ItemsSource="{Binding Games}"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderThickness="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="False"
                SelectionMode="Extended"
                SelectionChanged="GamesListView_SelectionChanged"
                dd:DragDrop.IsDragSource="True"
                dd:DragDrop.IsDropTarget="True"
                dd:DragDrop.DropHandler="{Binding}"
                dd:DragDrop.ShowAlwaysDropTargetAdorner="True">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{DynamicResource ControlBackgroundBrush}"
                            CornerRadius="6"
                            Padding="14,8"
                            Margin="0,0,0,6">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>  <!-- rank -->
                                    <ColumnDefinition Width="36"/>  <!-- cover -->
                                    <ColumnDefinition Width="*"/>   <!-- name -->
                                    <ColumnDefinition Width="20"/>  <!-- grip -->
                                </Grid.ColumnDefinitions>

                                <!-- Rank number -->
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Rank}"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextBrushDarker}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,0"/>

                                <!-- Cover thumbnail -->
                                <Border
                                    Grid.Column="1"
                                    Width="28" Height="28"
                                    CornerRadius="3"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlBackgroundBrush}">
                                    <Image
                                        Source="{Binding Cover}"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Game name -->
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Name}"
                                    FontSize="15"
                                    Foreground="{DynamicResource TextBrush}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"/>

                                <!-- Drag grip -->
                                <TextBlock
                                    Grid.Column="3"
                                    Text="⠿"
                                    FontSize="15"
                                    Opacity="0.45"
                                    Foreground="{DynamicResource GlyphBrush}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    ToolTip="Drag to reorder"/>
                            </Grid>

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="14,8"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <TextBlock
                Text="No games in Plan to Play."
                FontSize="13"
                Foreground="{DynamicResource TextBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- ── Status bar ── -->
        <Border
            Grid.Row="2"
            BorderBrush="{DynamicResource NormalBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,5">
            <TextBlock
                Text="{Binding StatusText}"
                FontSize="12"
                Foreground="{DynamicResource TextBrush}"/>
        </Border>
    </Grid>
</UserControl>
